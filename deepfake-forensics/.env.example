# Copy to .env (repository root) and adjust. Never commit .env.
# All backend variables use the DFF_ prefix. Relative paths are resolved against the repo root.

# --- general
DFF_ENVIRONMENT=development
DFF_LOG_LEVEL=INFO

# --- storage
DFF_STORAGE_DIR=storage                 # uploaded images + generated analysis artifacts
DFF_DATABASE_PATH=storage/app.db        # SQLite database
DFF_ARTIFACTS_DIR=artifacts             # checkpoints/, evaluations/, experiments/
DFF_REPORTS_DIR=reports                 # comparison tables/figures for the paper

# --- HTTP / security
DFF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# If set, every /api request must include header  X-API-Key: <value>
DFF_API_KEY=

# --- upload validation
DFF_MAX_UPLOAD_MB=15
DFF_MAX_IMAGE_PIXELS=40000000
DFF_MIN_IMAGE_SIDE=32

# --- inference
DFF_DEVICE=auto                         # auto | cpu | cuda | cuda:0
DFF_INFERENCE_AMP=true                  # float16 autocast on CUDA
DFF_MODEL_CACHE_SIZE=2                  # loaded models kept in memory
DFF_ENABLE_GRADCAM=true

# --- evaluation jobs started from the UI/API
DFF_DATA_ROOTS=data                     # comma-separated dirs allowed for dataset_root/manifest
DFF_JOB_WORKERS=1
DFF_DATASETS_CONFIG=ml/configs/datasets.local.yaml

# Optional per-dataset overrides instead of datasets.local.yaml:
# DFF_DATASET_GENIMAGE_V1_ROOT=D:/datasets/GenImage
# DFF_DATASET_GENIMAGE_V1_MANIFEST=data/manifests/genimage_v1.csv
